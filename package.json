{
  "name": "blobbyvolleyremake",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-transform-types tests/*.test.ts",
    "build:native": "BLOBBY_NATIVE=1 vite build",
    "android:sync": "pnpm build:native && cap sync android",
    "android:apk": "pnpm android:sync && tools/android-build.sh",
    "desktop:dev": "pnpm build:native && electron .",
    "desktop:mac": "pnpm build:native && electron-builder --mac",
    "desktop:win": "pnpm build:native && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@supabase/supabase-js": "^2.116.0",
    "three": "^0.180.0",
    "trystero": "^0.21.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^26.5.0",
    "@types/three": "^0.180.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "main": "desktop/main.cjs",
  "description": "Remake do Blobby Volley 2 em Three.js com multiplayer P2P por rollback netcode.",
  "author": {
    "name": "Esquyna Labs",
    "email": "esquynalabs@gmail.com"
  }
}
